{
  "enabled": true,
  "name": "Auto Commit on Task Complete",
  "description": "Automatically stages and commits all changes when a spec task is marked as completed, using a Conventional Commits message.",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Stage all changes with `git add -A` and commit them. Use the Conventional Commits format (https://www.conventionalcommits.org/en/v1.0.0/) for the commit message. Choose the appropriate type (feat, fix, refactor, chore, docs, style, test, etc.) based on the task that was just completed. The commit message should be concise and describe what was done. Example: `feat(auth): add login handler` or `chore: set up project structure`. Do not ask for confirmation — just commit."
  }
}